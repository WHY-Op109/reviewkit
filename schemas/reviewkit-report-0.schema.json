{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reviewkit.invalid/schemas/reviewkit-report-0.schema.json",
  "title": "Check report",
  "description": "The output envelope of every kit command (`lake exe review` and `scripts/rk_*.py`). Exit status: 0 no errors, 1 errors, 2 setup failure (then `setup_error` is set). Command-specific data may follow the listed fields (deliberately open at the top level and in each report).",
  "type": "object",
  "properties": {
    "format": {
      "const": "reviewkit-report/0",
      "description": "The format identifier, `reviewkit-report/0`."
    },
    "command": {
      "type": "string",
      "description": "The command that ran."
    },
    "config": {
      "type": "string",
      "description": "The config file passed, or empty."
    },
    "ok": {
      "type": "boolean",
      "description": "No errors (and no setup failure)."
    },
    "reports": {
      "type": "array",
      "description": "One report per check.",
      "items": {
        "$ref": "#/$defs/report"
      }
    },
    "setup_error": {
      "type": "string",
      "description": "Why the command could not run (exit status 2).",
      "minLength": 1
    },
    "faults": {
      "type": "object",
      "description": "The fault-fixture summary of `review faults` (deliberately open).",
      "additionalProperties": true
    },
    "fingerprints": {
      "type": "array",
      "description": "Rows of `review fingerprint`.",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "description": "One declaration's fingerprints."
      }
    },
    "records": {
      "type": "array",
      "description": "Rows of `review record` and `review attest`.",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "description": "One declaration's evidence record (id, path, status) or error."
      }
    },
    "sha256_vectors": {
      "type": "boolean",
      "description": "`review selftest`: the SHA-256 test vectors pass."
    }
  },
  "required": [
    "format",
    "command",
    "config",
    "ok"
  ],
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "ok": {
            "const": true
          }
        },
        "required": [
          "ok"
        ]
      },
      "then": {
        "not": {
          "required": [
            "setup_error"
          ]
        }
      },
      "description": "A report with a setup error is not ok."
    },
    {
      "if": {
        "properties": {
          "ok": {
            "const": true
          }
        },
        "required": [
          "ok"
        ]
      },
      "then": {
        "properties": {
          "reports": {
            "items": {
              "properties": {
                "ok": {
                  "const": true
                }
              }
            }
          }
        }
      },
      "description": "An ok envelope holds only ok reports."
    },
    {
      "if": {
        "properties": {
          "ok": {
            "const": false
          }
        },
        "required": [
          "ok",
          "reports"
        ]
      },
      "then": {
        "not": {
          "description": "every report is ok",
          "properties": {
            "reports": {
              "items": {
                "properties": {
                  "ok": {
                    "const": true
                  }
                }
              }
            }
          }
        }
      },
      "description": "An envelope that is not ok, with reports, holds at least one report that is not ok."
    },
    {
      "anyOf": [
        {
          "required": [
            "reports"
          ]
        },
        {
          "required": [
            "faults"
          ]
        },
        {
          "required": [
            "fingerprints"
          ]
        },
        {
          "required": [
            "records"
          ]
        },
        {
          "required": [
            "sha256_vectors"
          ]
        },
        {
          "required": [
            "setup_error"
          ]
        }
      ],
      "description": "Every envelope carries a body: reports, a fixture summary, fingerprint or evidence rows, the self-test result, or a setup error."
    }
  ],
  "$defs": {
    "report": {
      "type": "object",
      "description": "One check's result: diagnostics plus check-specific data (deliberately open).",
      "properties": {
        "check": {
          "type": "string",
          "description": "The check's name.",
          "minLength": 1
        },
        "ok": {
          "type": "boolean",
          "description": "No error diagnostics."
        },
        "errors": {
          "type": "integer",
          "description": "Number of error diagnostics.",
          "minimum": 0
        },
        "warnings": {
          "type": "integer",
          "description": "Number of warning diagnostics.",
          "minimum": 0
        },
        "diagnostics": {
          "type": "array",
          "description": "The findings.",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        }
      },
      "required": [
        "check",
        "ok",
        "errors",
        "warnings",
        "diagnostics"
      ],
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "ok": {
                "const": true
              }
            },
            "required": [
              "ok"
            ]
          },
          "then": {
            "properties": {
              "errors": {
                "const": 0
              }
            }
          },
          "description": "An ok report has no errors."
        },
        {
          "if": {
            "properties": {
              "errors": {
                "const": 0
              }
            },
            "required": [
              "errors"
            ]
          },
          "then": {
            "properties": {
              "ok": {
                "const": true
              }
            }
          },
          "description": "A report without errors is ok."
        }
      ]
    },
    "diagnostic": {
      "type": "object",
      "description": "One finding of a check.",
      "properties": {
        "check": {
          "type": "string",
          "description": "The check that produced it.",
          "minLength": 1
        },
        "code": {
          "type": "string",
          "description": "A stable identifier; fault fixtures match on it.",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "severity": {
          "enum": [
            "error",
            "warning",
            "info"
          ],
          "description": "Errors fail the check; warnings and information do not."
        },
        "message": {
          "type": "string",
          "description": "What was found, for a person."
        },
        "decl": {
          "$ref": "#/$defs/decl",
          "description": "The declaration concerned."
        },
        "module": {
          "$ref": "#/$defs/module",
          "description": "The module concerned."
        },
        "path": {
          "type": "array",
          "description": "A trace or location: for the Lean checks the chain of declarations, for `rk_schema.py` a one-element list holding a JSON pointer.",
          "items": {
            "type": "string"
          }
        },
        "file": {
          "type": "string",
          "description": "The file concerned.",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "check",
        "code",
        "severity",
        "message"
      ]
    },
    "decl": {
      "type": "string",
      "description": "An absolute Lean declaration id as `Name.toString` prints it (the ids `tracker graph` uses).",
      "minLength": 1
    },
    "module": {
      "type": "string",
      "description": "A Lean module name, for example `Pkg.Sub.Module`.",
      "minLength": 1
    }
  }
}
