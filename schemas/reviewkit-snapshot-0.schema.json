{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reviewkit.invalid/schemas/reviewkit-snapshot-0.schema.json",
  "title": "Tracker state snapshot",
  "description": "Every node's tracker state, written by `rk_snapshot.py take` from a `tracker graph` for the no-progress guard (B6.5): `rk_snapshot.py compare` ranks planned nodes (open < stated < axioms < proved) between two snapshots. Deterministic: no time stamp.",
  "type": "object",
  "properties": {
    "format": {
      "const": "reviewkit-snapshot/0",
      "description": "The format identifier, `reviewkit-snapshot/0`."
    },
    "nodes": {
      "type": "object",
      "description": "Every graph node, by declaration id.",
      "propertyNames": {
        "minLength": 1,
        "description": "A declaration id."
      },
      "additionalProperties": {
        "type": "object",
        "description": "One node's state.",
        "properties": {
          "state": {
            "enum": [
              "open",
              "stated",
              "proved",
              "axioms",
              "wrong"
            ],
            "description": "Tracker's state."
          },
          "planned": {
            "type": "boolean",
            "description": "The node is in the plan."
          },
          "wrong": {
            "type": "boolean",
            "description": "The plan marks it wrong (or its state is wrong)."
          },
          "deprecated": {
            "type": "boolean",
            "description": "The plan marks it deprecated."
          }
        },
        "additionalProperties": false,
        "required": [
          "state",
          "planned",
          "wrong",
          "deprecated"
        ]
      }
    },
    "totals": {
      "type": "object",
      "description": "Counts over the planned nodes (wrong ones counted as wrong, not by state), plus all nodes.",
      "properties": {
        "nodes": {
          "type": "integer",
          "description": "All nodes.",
          "minimum": 0
        },
        "planned": {
          "type": "integer",
          "description": "Planned nodes.",
          "minimum": 0
        },
        "open": {
          "type": "integer",
          "description": "Planned and open.",
          "minimum": 0
        },
        "stated": {
          "type": "integer",
          "description": "Planned and stated.",
          "minimum": 0
        },
        "axioms": {
          "type": "integer",
          "description": "Planned, resting on a non-standard axiom.",
          "minimum": 0
        },
        "proved": {
          "type": "integer",
          "description": "Planned and proved.",
          "minimum": 0
        },
        "wrong": {
          "type": "integer",
          "description": "Planned and marked wrong.",
          "minimum": 0
        },
        "deprecated": {
          "type": "integer",
          "description": "Planned and deprecated.",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "nodes",
        "planned",
        "open",
        "stated",
        "axioms",
        "proved",
        "wrong",
        "deprecated"
      ]
    },
    "commit": {
      "$ref": "#/$defs/commit",
      "description": "Optional: the commit the graph was computed at."
    }
  },
  "required": [
    "format",
    "nodes",
    "totals"
  ],
  "additionalProperties": false,
  "$defs": {
    "commit": {
      "type": "string",
      "description": "A full git commit id (40 lowercase hex digits).",
      "pattern": "^[0-9a-f]{40}$"
    }
  }
}
