{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reviewkit.invalid/schemas/reviewkit-worker-result-0.schema.json",
  "title": "Worker result record",
  "description": "A worker's result (K9, §2.5 step 4): the host wraps the worker's validated `output` (pass `$defs/output` to the CLI) with the fields only the host knows, so a model never writes its own provenance. The host re-validates everything (§2.5 step 5) and never trusts the self-reported lists alone.",
  "type": "object",
  "properties": {
    "format": {
      "const": "reviewkit-worker-result/0",
      "description": "The format identifier, `reviewkit-worker-result/0`."
    },
    "task_id": {
      "type": "string",
      "description": "The task record's id.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "model": {
      "$ref": "#/$defs/model"
    },
    "prompt_sha256": {
      "$ref": "#/$defs/sha256",
      "description": "sha256 of the exact prompt text sent (template filled in)."
    },
    "schema_sha256": {
      "$ref": "#/$defs/sha256",
      "description": "sha256 of the output schema passed to the CLI (`$defs/output` of this schema, serialised)."
    },
    "usage": {
      "$ref": "#/$defs/usage"
    },
    "repaired": {
      "type": "boolean",
      "description": "The one repair turn was used: the first answer failed schema validation."
    },
    "head_commit": {
      "anyOf": [
        {
          "$ref": "#/$defs/commit"
        },
        {
          "type": "null"
        }
      ],
      "description": "The workspace commit the result describes, or null if nothing was committed."
    },
    "output": {
      "$ref": "#/$defs/output"
    }
  },
  "required": [
    "format",
    "task_id",
    "model",
    "prompt_sha256",
    "schema_sha256",
    "usage",
    "repaired",
    "output"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "output": {
            "properties": {
              "outcome": {
                "const": "done"
              }
            },
            "required": [
              "outcome"
            ]
          }
        },
        "required": [
          "output"
        ]
      },
      "then": {
        "properties": {
          "output": {
            "properties": {
              "reason": {
                "const": "completed"
              }
            }
          }
        }
      },
      "description": "Only a finished task has reason `completed`, and a finished task has no other reason."
    },
    {
      "if": {
        "properties": {
          "output": {
            "properties": {
              "reason": {
                "const": "completed"
              }
            },
            "required": [
              "reason"
            ]
          }
        },
        "required": [
          "output"
        ]
      },
      "then": {
        "properties": {
          "output": {
            "properties": {
              "outcome": {
                "const": "done"
              }
            }
          }
        }
      }
    },
    {
      "properties": {
        "output": {
          "properties": {
            "plan_edits": {
              "items": {
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "node": {
                          "const": null
                        }
                      },
                      "required": [
                        "node"
                      ]
                    },
                    "then": {
                      "properties": {
                        "field": {
                          "enum": [
                            "namespace",
                            "desc",
                            "description"
                          ]
                        }
                      }
                    },
                    "description": "A module-level edit (node null) changes namespace, desc or description."
                  },
                  {
                    "if": {
                      "properties": {
                        "field": {
                          "const": "namespace"
                        }
                      },
                      "required": [
                        "field"
                      ]
                    },
                    "then": {
                      "properties": {
                        "node": {
                          "const": null
                        }
                      }
                    },
                    "description": "namespace is a module-level field: its edit has node null."
                  }
                ]
              }
            }
          }
        }
      },
      "description": "Plan edits name the module level (node null) exactly for the module's own fields (the output subset cannot say this)."
    }
  ],
  "$defs": {
    "output": {
      "type": "object",
      "description": "The worker's own result (the model-facing part).",
      "properties": {
        "outcome": {
          "type": "string",
          "enum": [
            "done",
            "partial",
            "rejected",
            "failed"
          ],
          "description": "`done`: the task is finished; `partial`: progress, not finished; `rejected`: the worker declines the task as posed (wrong statement, needs a human-owned or flagged change); `failed`: no usable progress."
        },
        "reason": {
          "type": "string",
          "enum": [
            "completed",
            "progress-made",
            "turn-limit",
            "no-proof-found",
            "statement-wrong",
            "missing-dependency",
            "upstream-needed",
            "plan-change-needed",
            "human-owned-change-needed",
            "fidelity-concern",
            "task-invalid",
            "build-broken",
            "environment-failure",
            "other"
          ],
          "description": "Why, from a fixed vocabulary: completed (done); progress-made, turn-limit (partial); no-proof-found; statement-wrong (the target is false or unprovable as stated: see wrong_marks); missing-dependency (a needed declaration does not exist yet); upstream-needed (a provider object is missing upstream); plan-change-needed (the plan or blueprint must change first); human-owned-change-needed (see proposals); fidelity-concern (see suspicions); task-invalid (the task record is inconsistent with the tree); build-broken (the base does not build); environment-failure (sandbox, tool or disk); other (explain in summary)."
        },
        "summary": {
          "type": "string",
          "description": "What was done and what is left, in a few sentences."
        },
        "changed_files": {
          "type": "array",
          "description": "Every file the worker changed.",
          "items": {
            "type": "object",
            "description": "A changed file.",
            "properties": {
              "path": {
                "type": "string",
                "description": "The path, relative to the repository root."
              },
              "change": {
                "type": "string",
                "enum": [
                  "added",
                  "modified",
                  "deleted",
                  "renamed"
                ],
                "description": "How it changed."
              },
              "previous_path": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The old path of a renamed file, else null."
              }
            },
            "required": [
              "path",
              "change",
              "previous_path"
            ],
            "additionalProperties": false
          }
        },
        "declarations": {
          "type": "array",
          "description": "Declarations touched.",
          "items": {
            "type": "object",
            "description": "A declaration touched.",
            "properties": {
              "decl": {
                "type": "string",
                "description": "The absolute declaration id."
              },
              "action": {
                "type": "string",
                "enum": [
                  "added",
                  "stated",
                  "defined",
                  "proved",
                  "replaced-placeholder",
                  "changed-statement",
                  "changed-proof",
                  "renamed",
                  "removed"
                ],
                "description": "What was done to it."
              },
              "previous_name": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The old id of a renamed declaration, else null."
              }
            },
            "required": [
              "decl",
              "action",
              "previous_name"
            ],
            "additionalProperties": false
          }
        },
        "plan_edits": {
          "type": "array",
          "description": "Edits to tracker plan files (flagged nodes go to the owner's queue, D19).",
          "items": {
            "type": "object",
            "description": "One plan edit.",
            "properties": {
              "file": {
                "type": "string",
                "description": "The plan file."
              },
              "node": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The node id, or null for a module-level field (`namespace`, `desc`, `description`)."
              },
              "field": {
                "type": "string",
                "enum": [
                  "namespace",
                  "node",
                  "id",
                  "kind",
                  "desc",
                  "description",
                  "deps",
                  "source",
                  "wrong",
                  "deprecated"
                ],
                "description": "The field edited; `node` for adding or removing a whole node; `namespace`, and `desc`/`description` with node null, for the module's own fields."
              },
              "before": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The TOML value before, as written, or null if absent."
              },
              "after": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The TOML value after, as written, or null if removed."
              }
            },
            "required": [
              "file",
              "node",
              "field",
              "before",
              "after"
            ],
            "additionalProperties": false
          }
        },
        "wrong_marks": {
          "type": "array",
          "description": "Statements the worker found false or unprovable as stated (tracker `wrong`).",
          "items": {
            "type": "object",
            "description": "A wrong mark.",
            "properties": {
              "decl": {
                "type": "string",
                "description": "The declaration id."
              },
              "reason": {
                "type": "string",
                "description": "Why it is wrong, as the plan's `wrong` field will say."
              },
              "evidence": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "A counterexample or a Lean refutation, or null."
              }
            },
            "required": [
              "decl",
              "reason",
              "evidence"
            ],
            "additionalProperties": false
          }
        },
        "suspicions": {
          "type": "array",
          "description": "Things a reviewer should look at.",
          "items": {
            "type": "object",
            "description": "A suspicion.",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "fidelity",
                  "vacuity",
                  "misleading-name",
                  "upstream-bug",
                  "other"
                ],
                "description": "`fidelity`: a definition may not mean what its source means; `vacuity`: a hypothesis or definition may make a statement trivially true or false; `misleading-name`: a name suggests another object; `upstream-bug`: an upstream declaration looks wrong; `other`."
              },
              "decl": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The declaration concerned, or null."
              },
              "detail": {
                "type": "string",
                "description": "What was seen and why it matters."
              }
            },
            "required": [
              "kind",
              "decl",
              "detail"
            ],
            "additionalProperties": false
          }
        },
        "proposals": {
          "type": "array",
          "description": "Proposed changes to human-owned paths: workers never edit them, they propose them (written to the queue).",
          "items": {
            "type": "object",
            "description": "A proposal.",
            "properties": {
              "path": {
                "type": "string",
                "description": "The human-owned path concerned."
              },
              "text": {
                "type": "string",
                "description": "The proposed change (a diff or the new text)."
              },
              "rationale": {
                "type": "string",
                "description": "Why it is needed."
              }
            },
            "required": [
              "path",
              "text",
              "rationale"
            ],
            "additionalProperties": false
          }
        },
        "checks_run": {
          "type": "array",
          "description": "Checks the worker ran in the workspace.",
          "items": {
            "type": "object",
            "description": "A check run.",
            "properties": {
              "command": {
                "type": "string",
                "description": "The command line."
              },
              "result": {
                "type": "string",
                "enum": [
                  "passed",
                  "failed",
                  "error"
                ],
                "description": "Its result."
              },
              "note": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "A short note (for example the first error), or null."
              }
            },
            "required": [
              "command",
              "result",
              "note"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "outcome",
        "reason",
        "summary",
        "changed_files",
        "declarations",
        "plan_edits",
        "wrong_marks",
        "suspicions",
        "proposals",
        "checks_run"
      ],
      "additionalProperties": false
    },
    "commit": {
      "type": "string",
      "description": "A full git commit id (40 lowercase hex digits).",
      "pattern": "^[0-9a-f]{40}$"
    },
    "model": {
      "type": "object",
      "description": "The model call, as the host ran it (never written by the model).",
      "properties": {
        "provider": {
          "$ref": "#/$defs/provider"
        },
        "model": {
          "type": "string",
          "description": "The model id the CLI reported (resolved, not an alias).",
          "minLength": 1
        },
        "effort": {
          "type": "string",
          "description": "The reasoning effort passed to the CLI, in its own vocabulary (for example `max`, `xhigh`, `high`).",
          "minLength": 1
        },
        "cli_version": {
          "type": "string",
          "description": "The CLI's version string (`claude --version`, `codex --version`).",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "effort",
        "cli_version"
      ]
    },
    "provider": {
      "enum": [
        "claude",
        "codex"
      ],
      "description": "The model CLI: `claude` (Claude Code, `claude -p`) or `codex` (`codex exec`)."
    },
    "sha256": {
      "type": "string",
      "description": "A SHA-256 hash: `sha256:` followed by 64 lowercase hex digits.",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "usage": {
      "type": "object",
      "description": "Token and cost usage as the CLI reported it, kept verbatim (deliberately open: each CLI has its own fields).",
      "additionalProperties": true
    }
  }
}
