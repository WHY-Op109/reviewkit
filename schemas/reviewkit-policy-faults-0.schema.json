{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reviewkit.invalid/schemas/reviewkit-policy-faults-0.schema.json",
  "title": "Policy-check fault fixtures",
  "description": "Fault fixtures for the Python checks (TOML), run by `rk_faults.py`. A fault passes only if every expected diagnostic is produced and every error is expected; a control passes only if it produces no unexpected error; a crash or a setup failure (exit 2) always fails the case (D43/F21).",
  "type": "object",
  "properties": {
    "format": {
      "const": "reviewkit-policy-faults/0",
      "description": "The format identifier, `reviewkit-policy-faults/0`."
    },
    "case": {
      "type": "array",
      "description": "The cases.",
      "items": {
        "$ref": "#/$defs/case"
      },
      "minItems": 1
    }
  },
  "required": [
    "format"
  ],
  "additionalProperties": false,
  "$defs": {
    "case": {
      "type": "object",
      "description": "One case.",
      "properties": {
        "name": {
          "type": "string",
          "description": "A unique, descriptive name.",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "fault",
            "control"
          ],
          "description": "`fault`: must produce its expected diagnostics; `control`: must produce no unexpected error."
        },
        "command": {
          "enum": [
            "extras",
            "owned-paths",
            "flagged",
            "pin-policy",
            "snapshot",
            "schema"
          ],
          "description": "The check script to run (`rk_<command>.py`, with `-` as `_`)."
        },
        "dir": {
          "type": "string",
          "description": "The fixture directory, relative to the faults file; the command runs there.",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "description": "The command's arguments.",
          "items": {
            "type": "string"
          }
        },
        "stdin": {
          "type": "string",
          "description": "Optional: text passed to the command on standard input."
        },
        "expect": {
          "type": "array",
          "description": "Expected diagnostics.",
          "items": {
            "$ref": "#/$defs/expect"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "command"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "fault"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "expect"
            ],
            "properties": {
              "expect": {
                "minItems": 1
              }
            }
          },
          "description": "A fault names at least one expected diagnostic."
        }
      ]
    },
    "expect": {
      "type": "object",
      "description": "A diagnostic the case must produce.",
      "properties": {
        "code": {
          "type": "string",
          "description": "The diagnostic code.",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "decl": {
          "type": "string",
          "description": "Optional: the declaration it must name.",
          "minLength": 1
        },
        "file": {
          "type": "string",
          "description": "Optional: the file it must name.",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "error",
            "warning",
            "info"
          ],
          "default": "error",
          "description": "The severity it must have (default error)."
        }
      },
      "additionalProperties": false,
      "required": [
        "code"
      ]
    }
  }
}
