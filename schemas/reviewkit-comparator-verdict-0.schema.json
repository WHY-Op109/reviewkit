{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reviewkit.invalid/schemas/reviewkit-comparator-verdict-0.schema.json",
  "title": "Comparator verdict record",
  "description": "The comparator's verdict (K6, D42; tier 3), stored as machine evidence. The four judgements D43/F06 keeps apart are separate fields: the machine's verdict (`output`, model-written), its specification agreement and its source independence (host-derived from the verdict and the source kind), and the human tiers (`human`, host-joined from attestations). Agreement with a secondary source (an AI-written docstring) is never independent agreement with the literature. The model-facing `$defs/output` holds no human field.",
  "type": "object",
  "properties": {
    "format": {
      "const": "reviewkit-comparator-verdict/0",
      "description": "The format identifier, `reviewkit-comparator-verdict/0`."
    },
    "kind": {
      "const": "comparator",
      "description": "The evidence kind."
    },
    "id": {
      "type": "string",
      "description": "The evidence id, `comparator:<decl>@<s12>.<d12>:<p12>` (p12: the first 12 hex digits of prompt_sha256).",
      "pattern": "^comparator:.+@[0-9a-f]{12}\\.[0-9a-f]{12}:[0-9a-f]{12}$"
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "readbacks": {
      "type": "array",
      "description": "The read-back evidence ids compared (normally one per channel).",
      "items": {
        "type": "string",
        "description": "A read-back evidence id.",
        "pattern": "^readback:\\S+$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "source": {
      "type": "object",
      "description": "The source the declaration was compared with (D42).",
      "properties": {
        "kind": {
          "enum": [
            "paper",
            "stacks-tag",
            "secondary",
            "none"
          ],
          "description": "`paper`: the paper's LaTeX; `stacks-tag`: a Stacks tag's LaTeX from the pinned Stacks Project; `secondary`: the declaration's citation and docstring wording; `none`: no source (a key definition with none moves up the owner's queue)."
        },
        "locator": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "Where in the source (paper and item, Stacks tag, citation), or null for none."
        },
        "sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ],
          "description": "sha256 of the source slice given to the comparator, or null for none."
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "locator",
        "sha256"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "none"
              }
            }
          },
          "then": {
            "properties": {
              "locator": {
                "type": "null"
              },
              "sha256": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "locator": {
                "type": "string"
              },
              "sha256": {
                "type": "string"
              }
            }
          },
          "description": "Only `none` has no locator and no slice."
        }
      ]
    },
    "model": {
      "$ref": "#/$defs/model"
    },
    "prompt_sha256": {
      "$ref": "#/$defs/sha256",
      "description": "sha256 of the exact prompt text sent (template filled in)."
    },
    "schema_sha256": {
      "$ref": "#/$defs/sha256",
      "description": "sha256 of the output schema passed to the CLI (`$defs/output` of this schema, serialised)."
    },
    "usage": {
      "$ref": "#/$defs/usage"
    },
    "repaired": {
      "type": "boolean",
      "description": "The one repair turn was used: the first answer failed schema validation."
    },
    "output": {
      "$ref": "#/$defs/output"
    },
    "specification_agreement": {
      "type": "object",
      "description": "Agreement with the specification, kept apart from independence (D43/F06). Derived by the host from `output.verdict` and the source kind.",
      "properties": {
        "status": {
          "enum": [
            "agree",
            "equivalent-different-presentation",
            "mismatch",
            "unclear",
            "not-applicable"
          ],
          "description": "The verdict against the source: `unclear` when the read-backs disagree, `not-applicable` when there is no source."
        },
        "against": {
          "enum": [
            "paper",
            "stacks-tag",
            "secondary",
            "none"
          ],
          "description": "The kind of source the agreement is with (equals `source.kind`)."
        }
      },
      "additionalProperties": false,
      "required": [
        "status",
        "against"
      ]
    },
    "source_independence": {
      "type": "object",
      "description": "Whether the source is independent of the formalisation (D43/F06).",
      "properties": {
        "independent": {
          "type": "boolean",
          "description": "The source is literature written independently of the code (a paper or the Stacks Project). False for a secondary source (an AI-written docstring) and for no source."
        },
        "gap": {
          "type": [
            "string",
            "null"
          ],
          "description": "The independent-source gap in words (what source is missing), or null when independent."
        }
      },
      "additionalProperties": false,
      "required": [
        "independent",
        "gap"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "independent": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "gap": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "else": {
            "properties": {
              "gap": {
                "type": "null"
              }
            }
          },
          "description": "A dependent source names its gap."
        }
      ]
    },
    "human": {
      "type": "object",
      "description": "The human tiers, host-joined from `review attestations` for cards and the queue; not part of the comparator's judgement and never model-written. A record stored as evidence carries this view only as of its writing: the attestations are the authority (D43/F11).",
      "properties": {
        "owner_check": {
          "type": "object",
          "description": "Tier 4: the owner's one-time check (`owner-check` attestations).",
          "properties": {
            "status": {
              "enum": [
                "pending",
                "attested",
                "stale"
              ],
              "description": "`pending`: no attestation; `attested`: a current attestation binds this subject; `stale`: the attestation is bound to other fingerprints."
            },
            "attestation": {
              "type": [
                "string",
                "null"
              ],
              "description": "The attestation id, or null when pending."
            }
          },
          "additionalProperties": false,
          "required": [
            "status",
            "attestation"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "pending"
                  }
                }
              },
              "then": {
                "properties": {
                  "attestation": {
                    "type": "null"
                  }
                }
              },
              "else": {
                "properties": {
                  "attestation": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "description": "Pending has no attestation; attested and stale name one."
            }
          ]
        },
        "expert_review": {
          "type": "object",
          "description": "Tier 5: the expert's review (`expert-review` attestations). Recorded separately; it gates nothing (D43/F06).",
          "properties": {
            "status": {
              "enum": [
                "pending",
                "attested",
                "stale"
              ],
              "description": "`pending`: no attestation; `attested`: a current attestation binds this subject; `stale`: the attestation is bound to other fingerprints."
            },
            "attestation": {
              "type": [
                "string",
                "null"
              ],
              "description": "The attestation id, or null when pending."
            }
          },
          "additionalProperties": false,
          "required": [
            "status",
            "attestation"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "pending"
                  }
                }
              },
              "then": {
                "properties": {
                  "attestation": {
                    "type": "null"
                  }
                }
              },
              "else": {
                "properties": {
                  "attestation": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "description": "Pending has no attestation; attested and stale name one."
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "owner_check",
        "expert_review"
      ]
    }
  },
  "required": [
    "format",
    "kind",
    "id",
    "subject",
    "readbacks",
    "source",
    "model",
    "prompt_sha256",
    "schema_sha256",
    "usage",
    "repaired",
    "output",
    "specification_agreement",
    "source_independence"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "source": {
            "properties": {
              "kind": {
                "const": "paper"
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "source"
        ]
      },
      "then": {
        "properties": {
          "specification_agreement": {
            "properties": {
              "against": {
                "const": "paper"
              }
            }
          }
        }
      },
      "description": "Specification agreement is against the record's source kind."
    },
    {
      "if": {
        "properties": {
          "source": {
            "properties": {
              "kind": {
                "const": "stacks-tag"
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "source"
        ]
      },
      "then": {
        "properties": {
          "specification_agreement": {
            "properties": {
              "against": {
                "const": "stacks-tag"
              }
            }
          }
        }
      },
      "description": "Specification agreement is against the record's source kind."
    },
    {
      "if": {
        "properties": {
          "source": {
            "properties": {
              "kind": {
                "const": "secondary"
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "source"
        ]
      },
      "then": {
        "properties": {
          "specification_agreement": {
            "properties": {
              "against": {
                "const": "secondary"
              }
            }
          }
        }
      },
      "description": "Specification agreement is against the record's source kind."
    },
    {
      "if": {
        "properties": {
          "source": {
            "properties": {
              "kind": {
                "const": "none"
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "source"
        ]
      },
      "then": {
        "properties": {
          "specification_agreement": {
            "properties": {
              "against": {
                "const": "none"
              }
            }
          }
        }
      },
      "description": "Specification agreement is against the record's source kind."
    },
    {
      "if": {
        "properties": {
          "source": {
            "properties": {
              "kind": {
                "enum": [
                  "secondary",
                  "none"
                ]
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "source"
        ]
      },
      "then": {
        "properties": {
          "source_independence": {
            "properties": {
              "independent": {
                "const": false
              }
            }
          }
        }
      },
      "description": "Agreement with a secondary source, or with none, is never independent."
    },
    {
      "if": {
        "properties": {
          "source": {
            "properties": {
              "kind": {
                "const": "none"
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "source"
        ]
      },
      "then": {
        "properties": {
          "specification_agreement": {
            "properties": {
              "status": {
                "const": "not-applicable"
              }
            }
          }
        }
      },
      "description": "Without a source there is no specification agreement."
    },
    {
      "if": {
        "allOf": [
          {
            "properties": {
              "output": {
                "properties": {
                  "verdict": {
                    "const": "agree"
                  }
                },
                "required": [
                  "verdict"
                ]
              }
            },
            "required": [
              "output"
            ]
          },
          {
            "properties": {
              "source": {
                "properties": {
                  "kind": {
                    "enum": [
                      "paper",
                      "stacks-tag",
                      "secondary"
                    ]
                  }
                },
                "required": [
                  "kind"
                ]
              }
            },
            "required": [
              "source"
            ]
          }
        ]
      },
      "then": {
        "properties": {
          "specification_agreement": {
            "properties": {
              "status": {
                "const": "agree"
              }
            }
          }
        }
      },
      "description": "With a source, the agreement status follows the verdict."
    },
    {
      "if": {
        "allOf": [
          {
            "properties": {
              "output": {
                "properties": {
                  "verdict": {
                    "const": "equivalent-different-presentation"
                  }
                },
                "required": [
                  "verdict"
                ]
              }
            },
            "required": [
              "output"
            ]
          },
          {
            "properties": {
              "source": {
                "properties": {
                  "kind": {
                    "enum": [
                      "paper",
                      "stacks-tag",
                      "secondary"
                    ]
                  }
                },
                "required": [
                  "kind"
                ]
              }
            },
            "required": [
              "source"
            ]
          }
        ]
      },
      "then": {
        "properties": {
          "specification_agreement": {
            "properties": {
              "status": {
                "const": "equivalent-different-presentation"
              }
            }
          }
        }
      },
      "description": "With a source, the agreement status follows the verdict."
    },
    {
      "if": {
        "allOf": [
          {
            "properties": {
              "output": {
                "properties": {
                  "verdict": {
                    "const": "mismatch"
                  }
                },
                "required": [
                  "verdict"
                ]
              }
            },
            "required": [
              "output"
            ]
          },
          {
            "properties": {
              "source": {
                "properties": {
                  "kind": {
                    "enum": [
                      "paper",
                      "stacks-tag",
                      "secondary"
                    ]
                  }
                },
                "required": [
                  "kind"
                ]
              }
            },
            "required": [
              "source"
            ]
          }
        ]
      },
      "then": {
        "properties": {
          "specification_agreement": {
            "properties": {
              "status": {
                "const": "mismatch"
              }
            }
          }
        }
      },
      "description": "With a source, the agreement status follows the verdict."
    },
    {
      "if": {
        "allOf": [
          {
            "properties": {
              "output": {
                "properties": {
                  "verdict": {
                    "const": "models-disagree"
                  }
                },
                "required": [
                  "verdict"
                ]
              }
            },
            "required": [
              "output"
            ]
          },
          {
            "properties": {
              "source": {
                "properties": {
                  "kind": {
                    "enum": [
                      "paper",
                      "stacks-tag",
                      "secondary"
                    ]
                  }
                },
                "required": [
                  "kind"
                ]
              }
            },
            "required": [
              "source"
            ]
          }
        ]
      },
      "then": {
        "properties": {
          "specification_agreement": {
            "properties": {
              "status": {
                "const": "unclear"
              }
            }
          }
        }
      },
      "description": "With a source, the agreement status follows the verdict."
    },
    {
      "if": {
        "properties": {
          "output": {
            "properties": {
              "verdict": {
                "enum": [
                  "agree",
                  "equivalent-different-presentation"
                ]
              }
            },
            "required": [
              "verdict"
            ]
          }
        },
        "required": [
          "output"
        ]
      },
      "then": {
        "properties": {
          "output": {
            "properties": {
              "axes": {
                "properties": {
                  "quantifiers": {
                    "enum": [
                      "ok",
                      "not-applicable"
                    ]
                  },
                  "hypotheses": {
                    "enum": [
                      "ok",
                      "not-applicable"
                    ]
                  },
                  "objects": {
                    "enum": [
                      "ok",
                      "not-applicable"
                    ]
                  },
                  "placeholders": {
                    "enum": [
                      "ok",
                      "not-applicable"
                    ]
                  },
                  "generality": {
                    "enum": [
                      "ok",
                      "not-applicable"
                    ]
                  }
                }
              }
            }
          }
        }
      },
      "description": "An agreeing verdict has no axis marked mismatch or unclear."
    },
    {
      "if": {
        "properties": {
          "output": {
            "properties": {
              "verdict": {
                "const": "mismatch"
              }
            },
            "required": [
              "verdict"
            ]
          }
        },
        "required": [
          "output"
        ]
      },
      "then": {
        "properties": {
          "output": {
            "properties": {
              "axes": {
                "anyOf": [
                  {
                    "properties": {
                      "quantifiers": {
                        "const": "mismatch"
                      }
                    },
                    "required": [
                      "quantifiers"
                    ]
                  },
                  {
                    "properties": {
                      "hypotheses": {
                        "const": "mismatch"
                      }
                    },
                    "required": [
                      "hypotheses"
                    ]
                  },
                  {
                    "properties": {
                      "objects": {
                        "const": "mismatch"
                      }
                    },
                    "required": [
                      "objects"
                    ]
                  },
                  {
                    "properties": {
                      "placeholders": {
                        "const": "mismatch"
                      }
                    },
                    "required": [
                      "placeholders"
                    ]
                  },
                  {
                    "properties": {
                      "generality": {
                        "const": "mismatch"
                      }
                    },
                    "required": [
                      "generality"
                    ]
                  }
                ]
              }
            }
          }
        }
      },
      "description": "A mismatch verdict marks at least one axis mismatch."
    },
    {
      "if": {
        "properties": {
          "output": {
            "properties": {
              "verdict": {
                "enum": [
                  "agree",
                  "equivalent-different-presentation"
                ]
              }
            },
            "required": [
              "verdict"
            ]
          }
        },
        "required": [
          "output"
        ]
      },
      "then": {
        "properties": {
          "output": {
            "properties": {
              "findings": {
                "items": {
                  "properties": {
                    "severity": {
                      "enum": [
                        "minor",
                        "note"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      },
      "description": "An agreeing verdict has no blocking finding."
    }
  ],
  "$defs": {
    "output": {
      "type": "object",
      "description": "The comparator's verdict (the model-facing part). It compares the two blind read-backs and the declaration with the source slice.",
      "properties": {
        "verdict": {
          "type": "string",
          "enum": [
            "agree",
            "equivalent-different-presentation",
            "mismatch",
            "models-disagree"
          ],
          "description": "`agree`: both read-backs match the source; `equivalent-different-presentation`: the same mathematics presented differently; `mismatch`: the declaration differs from the source; `models-disagree`: the two read-backs differ, so the reading itself is in doubt."
        },
        "axes": {
          "type": "object",
          "description": "The fixed review axes (D39), each ok | mismatch | unclear | not-applicable.",
          "properties": {
            "quantifiers": {
              "type": "string",
              "enum": [
                "ok",
                "mismatch",
                "unclear",
                "not-applicable"
              ],
              "description": "Quantifier and binder structure."
            },
            "hypotheses": {
              "type": "string",
              "enum": [
                "ok",
                "mismatch",
                "unclear",
                "not-applicable"
              ],
              "description": "Hypotheses: none missing, none extra."
            },
            "objects": {
              "type": "string",
              "enum": [
                "ok",
                "mismatch",
                "unclear",
                "not-applicable"
              ],
              "description": "The objects are the source's objects."
            },
            "placeholders": {
              "type": "string",
              "enum": [
                "ok",
                "mismatch",
                "unclear",
                "not-applicable"
              ],
              "description": "Placeholders stand for the objects they are registered for (the registered-placeholder rule)."
            },
            "generality": {
              "type": "string",
              "enum": [
                "ok",
                "mismatch",
                "unclear",
                "not-applicable"
              ],
              "description": "Stated at the generality the source uses, no more."
            }
          },
          "required": [
            "quantifiers",
            "hypotheses",
            "objects",
            "placeholders",
            "generality"
          ],
          "additionalProperties": false
        },
        "findings": {
          "type": "array",
          "description": "Specific findings.",
          "items": {
            "type": "object",
            "description": "A finding.",
            "properties": {
              "axis": {
                "type": "string",
                "enum": [
                  "quantifiers",
                  "hypotheses",
                  "objects",
                  "placeholders",
                  "generality",
                  "other"
                ],
                "description": "The axis it concerns."
              },
              "severity": {
                "type": "string",
                "enum": [
                  "blocking",
                  "minor",
                  "note"
                ],
                "description": "`blocking`: the definition must change or the owner must decide; `minor`: worth fixing; `note`: for the record."
              },
              "detail": {
                "type": "string",
                "description": "What differs, citing the read-back, the Lean and the source."
              }
            },
            "required": [
              "axis",
              "severity",
              "detail"
            ],
            "additionalProperties": false
          }
        },
        "summary": {
          "type": "string",
          "description": "The verdict's reason in a few sentences."
        }
      },
      "required": [
        "verdict",
        "axes",
        "findings",
        "summary"
      ],
      "additionalProperties": false
    },
    "decl": {
      "type": "string",
      "description": "An absolute Lean declaration id as `Name.toString` prints it (the ids `tracker graph` uses).",
      "minLength": 1
    },
    "fingerprintId": {
      "type": "string",
      "description": "Evidence id of a fingerprint record: `fingerprint:<decl>@<s12>.<d12>`, the first 12 hex digits of the statement fingerprint and of the digest.",
      "pattern": "^fingerprint:.+@[0-9a-f]{12}\\.[0-9a-f]{12}$"
    },
    "model": {
      "type": "object",
      "description": "The model call, as the host ran it (never written by the model).",
      "properties": {
        "provider": {
          "$ref": "#/$defs/provider"
        },
        "model": {
          "type": "string",
          "description": "The model id the CLI reported (resolved, not an alias).",
          "minLength": 1
        },
        "effort": {
          "type": "string",
          "description": "The reasoning effort passed to the CLI, in its own vocabulary (for example `max`, `xhigh`, `high`).",
          "minLength": 1
        },
