{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reviewkit.invalid/schemas/reviewkit-config-0.schema.json",
  "title": "Review kit project configuration",
  "description": "The project configuration (TOML, validated as the JSON value it decodes to). The kit names no project: every module prefix, rule and file path comes from this file (D35). A1's tables keep exactly the keys `lake exe review` accepts; version 0 adds `evidence`, `attestations`, `extras`, `tracker`, `owned`, `flagged` and `pin_policy`, all optional, so every A1 file stays valid. Human-owned policy (D43/F04).",
  "type": "object",
  "properties": {
    "format": {
      "const": "reviewkit-config/0",
      "description": "The format identifier, `reviewkit-config/0`."
    },
    "project": {
      "type": "object",
      "description": "The project's modules (required by `review`).",
      "properties": {
        "import": {
          "type": "array",
          "description": "Modules the checks import (the project roots).",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "modules": {
          "type": "array",
          "description": "Module prefixes that are project code.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "abstract": {
          "type": "string",
          "description": "The formal abstract module (D39).",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "import",
        "abstract"
      ]
    },
    "closure": {
      "type": "object",
      "description": "The closure walk (K1 `closure`).",
      "properties": {
        "background": {
          "type": "array",
          "description": "Module prefixes not entered by the walk (trusted background: Lean core, Mathlib, ...).",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "class": {
          "type": "array",
          "description": "Closure classes in order; the first whose module prefixes match a module applies.",
          "items": {
            "type": "object",
            "description": "A closure class: constants in these modules are entered and listed with this tag.",
            "properties": {
              "tag": {
                "type": "string",
                "description": "The tag listed in the key-definition list (for example `abstract`, `foundations`).",
                "minLength": 1
              },
              "modules": {
                "type": "array",
                "description": "Module prefixes of the class.",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": false,
            "required": [
              "tag"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "axioms": {
      "type": "object",
      "description": "The scoped axiom audit (K1 `axioms`).",
      "properties": {
        "allowed": {
          "type": "array",
          "description": "Axioms allowed anywhere (default: propext, Classical.choice, Quot.sound).",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "budget": {
          "type": "string",
          "description": "The human-owned sorry budget (`reviewkit-sorry-budget/0`), relative to the working directory.",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "imports": {
      "type": "object",
      "description": "The import rule (K1 `imports`).",
      "properties": {
        "rule": {
          "type": "array",
          "description": "Import rules; the first whose `module` prefix matches a module applies.",
          "items": {
            "type": "object",
            "description": "Modules with prefix `module` may import only modules with a prefix in `allow`.",
            "properties": {
              "module": {
                "type": "string",
                "description": "The module prefix the rule applies to.",
                "minLength": 1
              },
              "allow": {
                "type": "array",
                "description": "Module prefixes the matching modules may import.",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": false,
            "required": [
              "module"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "foundations_names": {
      "type": "object",
      "description": "The Foundations-name warning (warning only).",
      "properties": {
        "foundations": {
          "type": "array",
          "description": "Module prefixes of the Foundations layer.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "checked": {
          "type": "array",
          "description": "Library prefixes whose direct use by the abstract is checked.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "basic": {
          "type": "array",
          "description": "Name prefixes the abstract may use directly (basic vocabulary).",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": {
          "type": "array",
          "description": "Substantial objects (exact names) that must reach the abstract through a Foundations name.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "fingerprint": {
      "type": "object",
      "description": "Fingerprints (K1 `fingerprint`).",
      "properties": {
        "content": {
          "type": "array",
          "description": "Module prefixes whose constants are hashed by content (Merkle).",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unfold_abbrevs": {
          "type": "array",
          "description": "Module prefixes whose `abbrev`s are unfolded in the transitive digest.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notations": {
          "type": "array",
          "description": "Background notation constants unfolded before hashing (default: GT.gt, GE.ge).",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "pin": {
      "type": "object",
      "description": "The statement pin (K1 `pin`).",
      "properties": {
        "file": {
          "type": "string",
          "description": "The human-owned pin file (`reviewkit-statement-pin/0`), relative to the working directory.",
          "minLength": 1
        },
        "decls": {
          "type": "array",
          "description": "Declarations whose own statements are hard-pinned.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "placeholders": {
      "type": "object",
      "description": "The placeholder census (K1 `placeholders`).",
      "properties": {
        "modules": {
          "type": "array",
          "description": "Module prefixes whose placeholders must be tagged `@[placeholder]`.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "description": "Machine evidence records (D43/F11).",
      "properties": {
        "dir": {
          "type": "string",
          "description": "Directory of machine evidence records, relative to the working directory (default `evidence`).",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "attestations": {
      "type": "object",
      "description": "Human attestation records (D43/F11).",
      "properties": {
        "file": {
          "type": "string",
          "description": "The human-owned attestations file (`reviewkit-attestations/0`).",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "extras": {
      "type": "object",
      "description": "The extras file (`reviewkit-extras/0`) and its provider vocabulary (K8).",
      "properties": {
        "file": {
          "type": "string",
          "description": "The extras file, relative to the working directory.",
          "minLength": 1
        },
        "providers": {
          "type": "array",
          "description": "The allowed `provider` values.",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "require_provider": {
          "type": "boolean",
          "description": "Every extras entry must name its provider."
        }
      },
      "additionalProperties": false
    },
    "tracker": {
      "type": "object",
      "description": "How the checks call `tracker`.",
      "properties": {
        "plans": {
          "type": "string",
          "description": "The plan directory, passed as `--dir`.",
          "minLength": 1
        },
        "roots": {
          "type": "array",
          "description": "The root modules, passed as `--roots`.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "owned": {
      "type": "object",
      "description": "Human-owned paths (owned-paths check).",
      "properties": {
        "owners": {
          "type": "array",
          "description": "GitHub logins of the owners.",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "paths": {
          "type": "array",
          "description": "CODEOWNERS-style paths: a leading `/` anchors at the root, a trailing `/` is a directory.",
          "items": {
            "type": "string",
            "description": "An owned path.",
            "minLength": 1
          }
        },
        "codeowners": {
          "type": "string",
          "description": "The CODEOWNERS file, checked to cover every owned path with an owner (default `.github/CODEOWNERS`).",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "flagged": {
      "type": "object",
      "description": "Plan entries whose edits go to the owner (D19).",
      "properties": {
        "flags": {
          "type": "array",
          "description": "Extras flags (for example `key`, `chain`): an entry with any of them true flags its node.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "plan_fields": {
          "type": "array",
          "description": "The plan fields whose edits are flagged on a flagged node.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "pin_policy": {
      "type": "object",
      "description": "The lakefile, manifest and toolchain must agree (pin-policy check, D44).",
      "properties": {
        "package": {
          "type": "string",
          "description": "The pinned upstream package (its tag is in the lakefile).",
          "minLength": 1
        },
        "lakefile": {
          "type": "string",
          "description": "The Lake configuration file (default `lakefile.toml`).",
          "minLength": 1
        },
        "manifest": {
          "type": "string",
          "description": "The Lake manifest (default `lake-manifest.json`).",
          "minLength": 1
        },
        "toolchain": {
          "type": "string",
          "description": "The toolchain file (default `lean-toolchain`).",
          "minLength": 1
        },
        "extra_toolchains": {
          "type": "array",
          "description": "Further toolchain files that must equal the project toolchain.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "papers": {
      "type": "object",
      "description": "Reserved for the papers manifest tool; read by later kit tools (deliberately open).",
      "additionalProperties": true
    },
    "scout": {
      "type": "object",
      "description": "Reserved for the scout (K13): its sources and watched paths (deliberately open).",
      "additionalProperties": true
    },
    "upstream": {
      "type": "object",
      "description": "Upstream packages by Lake package name, each with its pin, plus `cache_service`.",
      "properties": {
        "cache_service": {
          "type": "string",
          "description": "The Lake cache service name used for upstream caches.",
          "minLength": 1
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/upstreamPackage"
      }
    }
  },
  "required": [
    "format",
    "project"
  ],
  "additionalProperties": false,
  "$defs": {
    "upstreamPackage": {
      "type": "object",
      "description": "The pin of one upstream package.",
      "properties": {
        "rev": {
          "type": "string",
          "description": "The pinned revision (a tag or a branch name).",
          "minLength": 1
        },
        "commit": {
          "$ref": "#/$defs/commit",
          "description": "The commit the revision resolves to."
        },
        "policy": {
          "type": "string",
          "description": "The pin policy in words (for example tags by default, with a named exception)."
        }
      },
      "additionalProperties": false,
      "required": [
        "rev",
        "commit"
      ]
    },
    "commit": {
      "type": "string",
      "description": "A full git commit id (40 lowercase hex digits).",
      "pattern": "^[0-9a-f]{40}$"
    }
  }
}
