{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reviewkit.invalid/schemas/reviewkit-blueprint-revision-0.schema.json",
  "title": "Blueprint revision record",
  "description": "A local blueprint revision by the loop's planner call (D19, D21): a wrong planned statement fixed, a node split, a missing intermediate node added. The host wraps the validated `output` (pass `$defs/output` to the CLI). Edits touching key or chain entries are flagged to the owner whatever the model says.",
  "type": "object",
  "properties": {
    "format": {
      "const": "reviewkit-blueprint-revision/0",
      "description": "The format identifier, `reviewkit-blueprint-revision/0`."
    },
    "id": {
      "type": "string",
      "description": "The revision id.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "request": {
      "type": "object",
      "description": "Why the revision was asked for.",
      "properties": {
        "reason": {
          "enum": [
            "wrong-statement",
            "split-node",
            "missing-node",
            "dependency-fix",
            "source-fix",
            "other"
          ],
          "description": "The trigger, from a fixed vocabulary."
        },
        "detail": {
          "type": "string",
          "description": "The request in words."
        },
        "nodes": {
          "type": "array",
          "description": "The nodes concerned.",
          "items": {
            "type": "string",
            "description": "A node id.",
            "minLength": 1
          },
          "minItems": 1
        },
        "task_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "The task whose result triggered it, or null."
        }
      },
      "additionalProperties": false,
      "required": [
        "reason",
        "nodes",
        "task_id"
      ]
    },
    "base_commit": {
      "$ref": "#/$defs/commit",
      "description": "The commit the revision was computed against."
    },
    "model": {
      "$ref": "#/$defs/model"
    },
    "prompt_sha256": {
      "$ref": "#/$defs/sha256",
      "description": "sha256 of the exact prompt text sent (template filled in)."
    },
    "schema_sha256": {
      "$ref": "#/$defs/sha256",
      "description": "sha256 of the output schema passed to the CLI (`$defs/output` of this schema, serialised)."
    },
    "usage": {
      "$ref": "#/$defs/usage"
    },
    "repaired": {
      "type": "boolean",
      "description": "The one repair turn was used: the first answer failed schema validation."
    },
    "output": {
      "$ref": "#/$defs/output"
    }
  },
  "required": [
    "format",
    "id",
    "request",
    "model",
    "prompt_sha256",
    "schema_sha256",
    "usage",
    "repaired",
    "output"
  ],
  "additionalProperties": false,
  "$defs": {
    "output": {
      "type": "object",
      "description": "The revision (the model-facing part).",
      "properties": {
        "summary": {
          "type": "string",
          "description": "What the revision changes and why, in a few sentences."
        },
        "plan_edits": {
          "type": "array",
          "description": "Edits to tracker plan files.",
          "items": {
            "type": "object",
            "description": "One plan edit.",
            "properties": {
              "file": {
                "type": "string",
                "description": "The plan file."
              },
              "node": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The node id, or null for a module-level field (`namespace`, `desc`, `description`)."
              },
              "op": {
                "type": "string",
                "enum": [
                  "add",
                  "change",
                  "remove"
                ],
                "description": "Add a node, change a field, or remove a node."
              },
              "field": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "namespace",
                      "node",
                      "id",
                      "kind",
                      "desc",
                      "description",
                      "deps",
                      "source",
                      "wrong",
                      "deprecated"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The field changed (`namespace`, and `desc`/`description` with node null, are module-level), or null for a whole-node add or remove."
              },
              "before": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The TOML text before, or null for an add."
              },
              "after": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The TOML text after, or null for a remove."
              }
            },
            "required": [
              "file",
              "node",
              "op",
              "field",
              "before",
              "after"
            ],
            "additionalProperties": false
          }
        },
        "blueprint_edits": {
          "type": "array",
          "description": "Edits to the Markdown blueprint.",
          "items": {
            "type": "object",
            "description": "One blueprint edit.",
            "properties": {
              "node": {
                "type": "string",
                "description": "The stable blueprint node id."
              },
              "op": {
                "type": "string",
                "enum": [
                  "add",
                  "change",
                  "remove"
                ],
                "description": "Add, change or remove the node."
              },
              "text": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The node's new Markdown text, or null for a remove."
              }
            },
            "required": [
              "node",
              "op",
              "text"
            ],
            "additionalProperties": false
          }
        },
        "flagged": {
          "type": "array",
          "description": "Edits that touch key or chain nodes (D19), as the model sees them: they go to the owner's queue. The host recomputes this list from the config and the extras file.",
          "items": {
            "type": "object",
            "description": "A flagged node.",
            "properties": {
              "node": {
                "type": "string",
                "description": "The node id."
              },
              "flags": {
                "type": "array",
                "description": "The flags it carries (for example key, chain).",
                "items": {
                  "type": "string",
                  "description": "A flag."
                }
              },
              "note": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Why the edit is needed despite the flag, or null."
              }
            },
            "required": [
              "node",
              "flags",
              "note"
            ],
            "additionalProperties": false
          }
        },
        "rationale": {
          "type": "string",
          "description": "The mathematical reasoning behind the revision."
        },
        "sources": {
          "type": "array",
          "description": "Sources consulted.",
          "items": {
            "type": "object",
            "description": "A source.",
            "properties": {
              "locator": {
                "type": "string",
                "description": "Paper and item, Stacks tag, or other citation."
              },
              "note": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "What it supports, or null."
              }
            },
            "required": [
              "locator",
              "note"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "summary",
        "plan_edits",
        "blueprint_edits",
        "flagged",
        "rationale",
        "sources"
      ],
      "additionalProperties": false
    },
    "commit": {
      "type": "string",
      "description": "A full git commit id (40 lowercase hex digits).",
      "pattern": "^[0-9a-f]{40}$"
    },
    "model": {
      "type": "object",
      "description": "The model call, as the host ran it (never written by the model).",
      "properties": {
        "provider": {
          "$ref": "#/$defs/provider"
        },
        "model": {
          "type": "string",
          "description": "The model id the CLI reported (resolved, not an alias).",
          "minLength": 1
        },
        "effort": {
          "type": "string",
          "description": "The reasoning effort passed to the CLI, in its own vocabulary (for example `max`, `xhigh`, `high`).",
          "minLength": 1
        },
        "cli_version": {
          "type": "string",
          "description": "The CLI's version string (`claude --version`, `codex --version`).",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "effort",
        "cli_version"
      ]
    },
    "provider": {
      "enum": [
        "claude",
        "codex"
      ],
      "description": "The model CLI: `claude` (Claude Code, `claude -p`) or `codex` (`codex exec`)."
    },
    "sha256": {
      "type": "string",
      "description": "A SHA-256 hash: `sha256:` followed by 64 lowercase hex digits.",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "usage": {
      "type": "object",
      "description": "Token and cost usage as the CLI reported it, kept verbatim (deliberately open: each CLI has its own fields).",
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "properties": {
        "output": {
          "properties": {
            "plan_edits": {
              "items": {
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "node": {
                          "const": null
                        }
                      },
                      "required": [
                        "node"
                      ]
                    },
                    "then": {
                      "properties": {
                        "field": {
                          "enum": [
                            "namespace",
                            "desc",
                            "description"
                          ]
                        },
                        "op": {
                          "const": "change"
                        }
                      }
                    },
                    "description": "A module-level edit (node null) changes namespace, desc or description."
                  },
                  {
                    "if": {
                      "properties": {
                        "field": {
                          "const": "namespace"
                        }
                      },
                      "required": [
                        "field"
                      ]
                    },
                    "then": {
                      "properties": {
                        "node": {
                          "const": null
                        }
                      }
                    },
                    "description": "namespace is a module-level field: its edit has node null."
                  }
                ]
              }
            }
          }
        }
      },
      "description": "Plan edits name the module level (node null) exactly for the module's own fields (the output subset cannot say this)."
    }
  ]
}
